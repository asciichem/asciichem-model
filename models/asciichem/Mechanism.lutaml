class Mechanism {
  definition {
    A reaction mechanism: labelled reaction steps plus spectator
    species that are present but not transformed.
  }
  +steps: MechanismStep[0..*] {
    definition { The mechanism steps in order. }
  }
  +spectators: Molecule[0..*] {
    definition { Species present but not transformed. }
  }

  class MechanismStep {
    definition { One labelled step of the mechanism. }
    +label: String {
      definition { Step label, e.g. "initiation". }
    }
    +reaction: Reaction {
      definition { The step's reaction. }
    }
    +flows: MechanismFlow[0..*] {
      definition { Electron-flow markers drawn for this step. }
    }
  }

  class MechanismFlow {
    definition { One electron-flow marker: arrow source to target. }
    +source: String {
      definition { A bond or species the arrow starts at, verbatim. }
    }
    +target: String {
      definition { What the arrow points to, verbatim. }
    }
  }
}
